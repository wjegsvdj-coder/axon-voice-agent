<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXON"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:text="Checking permissions..."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Command ya baat likho (e.g. battery, script banao gold)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run command" />

        <Button
            android:id="@+id/btnService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start always-on listening" />

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable accessibility service" />

        <Button
            android:id="@+id/btnWriteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow system writes" />

        <Button
            android:id="@+id/btnDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow DND control" />

        <Button
            android:id="@+id/btnBrain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brain settings (optional)" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:text="One-time PC command for deep settings:"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="adb shell pm grant com.assistant.exon android.permission.WRITE_SECURE_SETTINGS"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

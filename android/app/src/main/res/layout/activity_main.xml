<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXON"
            android:letterSpacing="0.25"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:text="Ready"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bolo ya likho…"
                android:textColorHint="@color/muted"
                android:textColor="@color/text"
                android:background="@null"
                android:inputType="text" />

            <Button
                android:id="@+id/btnMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ask" />
        </LinearLayout>

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/latency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Always-on listening" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility access" />

        <Button
            android:id="@+id/btnWriteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System write access" />

        <Button
            android:id="@+id/btnDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Do Not Disturb access" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory" />

        <!-- Advanced block: hidden until long-press on EXON title -->
        <LinearLayout
            android:id="@+id/advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBrain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brain" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="One-time PC command:"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="adb shell pm grant com.assistant.exon android.permission.WRITE_SECURE_SETTINGS"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
